numero1 = float(input("Digite um numero: "))
numero2 = float(input("Digite outro numero: "))
operador = (input("digite o operador: "))
if operador == '-':
    resultado = numero1 - numero2
    print("Subtração selecionado ", resultado)
elif operador == '+':
    resultado = numero1 + numero2
    print("Adição selecionado ", resultado)
elif operador == '*':
    resultado = numero1 * numero2
    print("Multiplicação selecionado ", resultado)
elif operador == '/':
    if numero2 != 0:
        print('por favor digite um numero valido')
    resultado = numero1 / numero2
    print("Divisão selecionado ", resultado)
